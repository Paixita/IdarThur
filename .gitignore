# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Modelo generado durante la instalación (no publicar pesos en Git).
/assets/kokoro-model/

# Flutter and independent API build artifacts
**/node_modules/
**/.next/
**/assets/kokoro-model/
mobile/app/build/
mobile/app/.dart_tool/
mobile/app/android/.gradle/
mobile/app/android/.kotlin/
**/key.properties
**/*.jks
**/*.keystore
**/local.properties
